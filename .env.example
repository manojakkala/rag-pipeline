# Copy this file to a new file named exactly ".env" and fill in the value below.
# .env is gitignored, so your password never gets committed or shared.
#
# Paste your Postgres connection string here. If you use Neon (recommended),
# it looks like the line below (Neon shows it to you right after you create a project):
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Groq free API key for the generation step. Get one free at https://console.groq.com
GROQ_API_KEY=gsk_...
